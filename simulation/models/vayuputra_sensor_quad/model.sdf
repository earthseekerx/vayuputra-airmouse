<?xml version="1.0"?>
<sdf version="1.9">
  <model name="vayuputra_sensor_quad">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial><mass>1.5</mass><inertia><ixx>0.029</ixx><iyy>0.029</iyy><izz>0.052</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="body_collision"><geometry><box><size>0.24 0.18 0.07</size></box></geometry></collision>
      <visual name="body_visual"><geometry><box><size>0.24 0.18 0.07</size></box></geometry><material><ambient>0.08 0.18 0.32 1</ambient><diffuse>0.08 0.18 0.32 1</diffuse></material></visual>
      <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>250</update_rate><topic>/vayuputra/imu</topic><imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z></linear_acceleration></imu></sensor>
      <sensor name="front_lidar" type="gpu_lidar"><pose>0.12 0 0.02 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/vayuputra/lidar/scan</topic><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.15</min><max>12</max><resolution>0.01</resolution></range></lidar></sensor>
      <sensor name="depth_camera" type="rgbd_camera"><pose>0.10 0 0 0 0 0</pose><always_on>true</always_on><update_rate>15</update_rate><topic>/vayuputra/depth</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera></sensor>
    </link>
    <link name="arm_x"><pose>0 0 0 0 0 0</pose><inertial><mass>0.15</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.48 0.035 0.025</size></box></geometry></visual></link>
    <joint name="arm_fixed" type="fixed"><parent>base_link</parent><child>arm_x</child></joint>
  </model>
</sdf>
